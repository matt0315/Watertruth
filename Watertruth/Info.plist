	<string>Add progress photos to your plant journal.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of your plant for its profile or journal.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Watertruth sends soil-check reminders so you water at the right time.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
